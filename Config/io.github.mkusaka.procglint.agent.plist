<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.mkusaka.procglint.agent</string>
    <key>BundleProgram</key>
    <string>Contents/Helpers/procglint-agent</string>
    <!-- MachServices launches on demand; no RunAtLoad/KeepAlive so the idle agent can exit. -->
    <key>MachServices</key>
    <dict>
        <key>io.github.mkusaka.procglint.agent</key>
        <true/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
